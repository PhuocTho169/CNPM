PORT=5000
# On host: localhost:5432. Inside Docker: postgres:5432 (docker-compose overrides this)
DATABASE_URL=postgresql://district4_user:district4_password@localhost:5432/district4_food
JWT_SECRET=change_this_secret
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# TTS provider — để trống = Google Translate TTS MIỄN PHÍ, không cần API key,
# mỗi ngôn ngữ đọc bằng giọng bản xứ (vi/zh/ko/ja).
#   google     = Google Cloud TTS (cần TTS_API_KEY)
#   elevenlabs = ElevenLabs (cần TTS_API_KEY)
#   edge       = Edge TTS (cần python3 + gói edge-tts)
#   none       = tắt hẳn TTS server (chỉ còn browser TTS + upload tay)
TTS_PROVIDER=
TTS_API_KEY=
