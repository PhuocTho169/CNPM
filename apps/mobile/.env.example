# Mobile app environment
# IMPORTANT: Do NOT use localhost for real-device testing.
# Replace with your development computer's LAN IP (same Wi-Fi as your phone).
# Find it with `ipconfig` (Windows) or `ifconfig` (macOS/Linux).
#
# Watch the port: docker-compose runs the API on 5000 inside the container but
# publishes it on 5001 on the host, so a real phone needs the host port (5001).
EXPO_PUBLIC_API_URL=http://192.168.1.100:5001/api
