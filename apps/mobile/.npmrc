# Metro's bundler is far happier with a flat node_modules than with pnpm's
# symlinked virtual store.
#
# With the default (isolated) linker, `babel-preset-expo` is resolved through
# .pnpm virtual-store directories whose peer links are fragile: Metro fails with
# "Cannot find module '@babel/core'" from
# babel-preset-expo/build/client-module-proxy-plugin.js even though @babel/core
# is installed. A hoisted layout removes that whole class of failure.
node-linker=hoisted