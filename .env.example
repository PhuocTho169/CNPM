# Root-level reference file.
# Docker Compose reads ./server/.env for the API server container.

# ---------- server/.env ----------
PORT=5000
# Inside Docker: postgres:5432 (service name). On host: localhost:5432.
DATABASE_URL=postgresql://district4_user:district4_password@localhost:5432/district4_food
JWT_SECRET=change_this_secret
UPLOAD_DIR=uploads
# Public URL of the React website (used to build QR code targets)
PUBLIC_BASE_URL=http://localhost:5173
# CORS origin of the React website
FRONTEND_URL=http://localhost:5173
# Text-to-speech provider: để trống = Google Translate TTS miễn phí (không cần key,
# giọng bản xứ vi/zh/ko/ja); "google"/"elevenlabs" cần TTS_API_KEY; "edge" cần python3;
# "none" = tắt hẳn TTS server.
TTS_PROVIDER=
TTS_API_KEY=

# ---------- apps/web/.env ----------
VITE_API_URL=http://localhost:5000/api

# ---------- apps/mobile/.env ----------
# Must be your computer's LAN IP, not localhost, for a real phone.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
