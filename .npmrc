# pnpm workspace layout that works with Expo/Metro.
#
# Metro resolves React Native packages through Node-style directory walking. With
# pnpm's default isolated linker, packages live under the .pnpm virtual store
# and are reached via symlinks whose peer links are fragile — Metro fails with
# "Cannot find module '@babel/core'" from inside babel-preset-expo even though
# @babel/core is installed and listed in package.json.
#
# A hoisted layout flattens node_modules, which is the layout Metro is tested
# against. The trade-off is a larger, less isolated node_modules; nothing in
# this repo depends on pnpm's strict isolation.
node-linker=hoisted
# The Docker dev services install into pre-existing named volumes for
# node_modules. When the linker or the pnpm major changes, pnpm wants to purge
# that directory first — and it aborts without a TTY, so the container exits 1
# before anything is installed. Allow the purge so startup stays idempotent.
confirmModulesPurge=false
